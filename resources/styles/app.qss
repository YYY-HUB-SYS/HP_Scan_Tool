/* ============================================
   HP Scan Tool v4.0 — 统一样式表
   设计系统: Soft UI Evolution + Micro-interactions
   ============================================ */

/* ─── 全局 ─── */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 10pt;
}

QMainWindow {
    background: #F8FAFC;
}

/* ─── 左侧面板 ─── */
QFrame#scannerPanel {
    background: #F1F5F9;
    border-right: 1px solid #E2E8F0;
    min-width: 260px;
}

/* ─── 扫描仪卡片 ─── */
ScannerCard {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    min-height: 68px;
}

ScannerCard:hover {
    border-color: #0D9488;
    background: #F0FDFA;
}

ScannerCard[selected="true"] {
    border-color: #0D9488;
    background: #F0FDFA;
}

/* ─── 主按钮（扫描） ─── */
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0D9488, stop:1 #14B8A6);
    color: white;
    border: none;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0F766E, stop:1 #0D9488);
}

QPushButton#primaryButton:pressed {
    background: #0F766E;
}

QPushButton#primaryButton:disabled {
    background: #94A3B8;
    color: #E2E8F0;
}

/* ─── 次要按钮 ─── */
QPushButton#secondaryButton {
    background: #FFFFFF;
    color: #334155;
    border: 1.5px solid #E2E8F0;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton#secondaryButton:hover {
    border-color: #0D9488;
    color: #0D9488;
    background: #F0FDFA;
}

QPushButton#secondaryButton:pressed {
    background: #E8F1F4;
}

/* ─── 强调按钮（监听模式） ─── */
QPushButton#accentButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #EA580C, stop:1 #F97316);
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 500;
}

QPushButton#accentButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #C2410C, stop:1 #EA580C);
}

/* ─── 输入框 ─── */
QLineEdit {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1E293B;
    selection-background-color: #0D9488;
    min-height: 20px;
}

QLineEdit:focus {
    border-color: #0D9488;
    background: #F0FDFA;
}

QLineEdit:disabled {
    background: #F1F5F9;
    color: #94A3B8;
}

/* ─── 下拉框样式统一由 Python _create_styled_combo 管理 ─── */

/* ─── 复选框 ─── */
QCheckBox {
    color: #334155;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #CBD5E1;
    border-radius: 4px;
    background: white;
}

QCheckBox::indicator:hover {
    border-color: #0D9488;
}

QCheckBox::indicator:checked {
    background: #0D9488;
    border-color: #0D9488;
    image: none;
}

/* ─── 分组框 ─── */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: #1E293B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #0D9488;
}

/* ─── 进度条 ─── */
QProgressBar {
    background: #E2E8F0;
    border-radius: 8px;
    text-align: center;
    color: #64748B;
    font-size: 9px;
    max-height: 16px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0D9488, stop:1 #14B8A6);
    border-radius: 8px;
}

/* ─── 滚动条 ─── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}

/* ─── 状态栏 ─── */
QStatusBar {
    background: #F1F5F9;
    color: #64748B;
    border-top: 1px solid #E2E8F0;
}

/* ─── 标签 ─── */
QLabel {
    color: #334155;
}

QLabel#headerLabel {
    font-size: 16px;
    font-weight: bold;
    color: #1E293B;
}

QLabel#subHeaderLabel {
    font-size: 12px;
    color: #64748B;
}

QLabel#mutedLabel {
    color: #94A3B8;
}

/* ─── 对话框 ─── */
QDialog {
    background: #F8FAFC;
}

/* ─── 图像预览区 ─── */
ImageViewer {
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

/* ─── 缩略图按钮 ─── */
QPushButton#thumbButton {
    border: 2px solid #E2E8F0;
    border-radius: 6px;
    background: white;
    padding: 2px;
}

QPushButton#thumbButton:hover {
    border-color: #0D9488;
}

QPushButton#thumbButton[selected="true"] {
    border-color: #0D9488;
    background: #F0FDFA;
}

/* ─── 工具按钮 ─── */
QPushButton#toolButton {
    background: transparent;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 6px 12px;
    color: #64748B;
}

QPushButton#toolButton:hover {
    border-color: #0D9488;
    color: #0D9488;
    background: #F0FDFA;
}

/* ─── 树形控件 ─── */
QTreeWidget {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    outline: none;
}

QTreeWidget::item {
    padding: 8px 4px;
    border-bottom: 1px solid #F1F5F9;
}

QTreeWidget::item:hover {
    background: #F0FDFA;
}

QTreeWidget::item:selected {
    background: #E8F1F4;
    color: #0D9488;
}

QHeaderView::section {
    background: #F1F5F9;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    padding: 8px;
    font-weight: bold;
    color: #475569;
}

/* ─── 滚动区域 ─── */
QScrollArea {
    border: none;
    background: transparent;
}

/* ─── 分割器 ─── */
QSplitter::handle {
    background: #E2E8F0;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background: #0D9488;
}
